---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as Overview } from '../content/sections/architecture-overview.md';
---

<BaseLayout title="Target Architecture">

  <div class="page-hero">
    <div class="hero-eyebrow">Technical reference</div>
    <h1 class="page-title">Target Architecture</h1>
    <p class="page-subtitle">The end-state architecture the programme is working towards.</p>
  </div>

  <div class="page-body">
    <h2 class="section-heading">Overview</h2>
    <div class="prose"><Overview /></div>

    <p class="aside">The Phase 3 Harbour and Crane proof of concept architecture is documented on the <a href="/phases/phase-3">Phase 3 page</a>. This page is for the broader target architecture the programme is working towards across Phase 4 and beyond.</p>
  </div>

</BaseLayout>

<style>
  .aside {
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--sidebar-bg);
    border-left: 3px solid var(--esco-teal);
    padding: 0.75rem 1rem;
    border-radius: 0 6px 6px 0;
    margin-top: 2rem;
  }
  .aside a { color: var(--accent); }
</style>
