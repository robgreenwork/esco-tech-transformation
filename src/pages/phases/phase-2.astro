---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Content as Hypothesis } from '../../content/sections/phase-2-hypothesis.md';
import { Content as Explored }   from '../../content/sections/phase-2-explored.md';
import { Content as Found }      from '../../content/sections/phase-2-found.md';
import { Content as Decision }   from '../../content/sections/phase-2-decision.md';
import { Content as Documents }  from '../../content/sections/phase-2-documents.md';
---

<BaseLayout title="Phase 2 -- Off-the-shelf replacement for Myriad">

  <div class="page-hero">
    <div class="hero-eyebrow">Phase 2 · May 2023 to June 2024</div>
    <h1 class="page-title">Buy an off-the-shelf replacement for Myriad</h1>
    <p class="page-subtitle"><span class="verdict rejected">Not affordable</span></p>
  </div>

  <div class="page-body">

  <h2 class="section-heading">Hypothesis</h2>
  <div class="prose"><Hypothesis /></div>

  <h2 class="section-heading">What we explored</h2>
  <div class="prose"><Explored /></div>

  <h2 class="section-heading">What we found</h2>
  <div class="prose"><Found /></div>

  <h2 class="section-heading">Decision and reasoning</h2>
  <div class="prose"><Decision /></div>

  <h2 class="section-heading">Key supporting documents</h2>
  <div class="prose doc-list"><Documents /></div>

  <div class="page-nav">
    <a href="/phases/phase-1"><span aria-hidden="true">&lt;-</span> Phase 1</a>
    <a href="/phases/phase-3">Phase 3 <span aria-hidden="true">-&gt;</span></a>
  </div>

  </div>
</BaseLayout>

<style>
  .doc-list :global(ul) { font-size: 0.9rem; color: var(--text-muted); line-height: 1.9; }
  .page-nav { display: flex; justify-content: space-between; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); font-size: 0.875rem; font-weight: 600; }
  .page-nav a { color: var(--accent); text-decoration: none; }
  .page-nav a:hover { text-decoration: underline; }
</style>
