---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as HomeAbout }     from '../content/sections/home-about.md';
import { Content as HomeIntro }     from '../content/sections/home-intro.md';
import { Content as HomePhase4 }    from '../content/sections/home-phase4-note.md';
import { Content as HomeHowToUse }  from '../content/sections/home-how-to-use.md';

const phases = [
  {
    number: '1',
    period: 'Phase 1',
    label: 'Build on Azure and the Microsoft stack',
    dates: 'Mid-2022 to Early 2023',
    verdict: 'Not viable',
    verdictClass: 'rejected',
    href: '/phases/phase-1',
    summary: 'Evaluated the feasibility of moving existing infrastructure entirely to the cloud using Microsoft Azure. Concluded this was too expensive, too disruptive, and the legacy Myriad database had compatibility issues.',
  },
  {
    number: '2',
    period: 'Phase 2',
    label: 'Buy an off-the-shelf replacement for Myriad',
    dates: 'May 2023 to June 2024',
    verdict: 'Not affordable',
    verdictClass: 'rejected',
    href: '/phases/phase-2',
    summary: 'Researched off-the-shelf replacement software for Myriad. Found that alternatives were significantly more expensive, and that bespoke integrations were too tightly coupled to Myriad for a clean migration.',
  },
  {
    number: '3',
    period: 'Phase 3',
    label: 'Hybrid build and buy -- interchangeable adaptable infrastructure',
    dates: 'Late 2023 to Mid-2025',
    verdict: 'Chosen path',
    verdictClass: 'chosen',
    href: '/phases/phase-3',
    summary: 'Built the Harbour and Crane architecture to prove a CRM-agnostic approach, initially focused on the Single Customer View product. Technical concept was validated. Now expanding to cover core Subscriptions, Memberships, and Charities (Phase 4).',
  },
];
---

<BaseLayout title="Overview">

  <div class="page-hero">
    <div class="hero-eyebrow">Programme overview</div>
    <h1 class="page-title">ESco Tech Transformation</h1>
    <p class="page-subtitle">A four-year programme of work to understand, explore, and ultimately decide the future technology direction for ESco. This site documents the journey -- the hypotheses tested, the evidence gathered, the decisions made, and the path chosen.</p>
  </div>

  <div class="page-body">

  <h2 class="section-heading">About this programme</h2>
  <div class="prose"><HomeAbout /></div>

  <h2 class="section-heading">The three phases</h2>
  <div class="prose intro-prose"><HomeIntro /></div>

  <div class="timeline">
    {phases.map((phase, i) => (
      <div class="timeline-item">
        <div class="timeline-connector">
          <div class="timeline-dot"><span>{phase.number}</span></div>
          {i < phases.length - 1 && <div class="timeline-line" />}
        </div>
        <div class="timeline-card">
          <div class="timeline-card-header">
            <span class="phase-label">{phase.period}</span>
            <span class="phase-dates">{phase.dates}</span>
            <span class={`verdict ${phase.verdictClass}`}>{phase.verdict}</span>
          </div>
          <h3 class="timeline-title">{phase.label}</h3>
          <p class="timeline-desc">{phase.summary}</p>
          <a href={phase.href} class="timeline-link">Read phase detail <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    ))}
  </div>

  <div class="note-box prose"><HomePhase4 /></div>

  <h2 class="section-heading">How to use this site</h2>
  <div class="prose"><HomeHowToUse /></div>

  </div>
</BaseLayout>

<style>
  .intro-prose :global(p) { color: var(--text-muted); margin-bottom: 2rem; }

  .note-box {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    padding: 0.875rem 1.1rem;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }
  .note-box :global(p) { color: #1e40af; font-size: 0.875rem; margin-bottom: 0; }
  .note-box :global(a) { color: #1d4ed8; }

  /* TIMELINE */
  .timeline { display: flex; flex-direction: column; gap: 0; margin-bottom: 2rem; }
  .timeline-item { display: flex; gap: 1.25rem; align-items: flex-start; }
  .timeline-connector { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; padding-top: 1.125rem; }
  .timeline-dot { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: white; display: flex; align-items: center; justify-content: center; font-size: 0.875rem; font-weight: 700; }
  .timeline-line { width: 2px; flex: 1; background: var(--border); min-height: 2rem; }
  .timeline-card { flex: 1; border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; background: #fff; }
  .timeline-card-header { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .phase-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); }
  .phase-dates { font-size: 0.75rem; color: var(--text-faint); }
  .phase-dates::before { content: '\00B7'; margin-right: 0.4rem; }
  .timeline-title { font-size: 1rem; font-weight: 600; color: var(--text); line-height: 1.3; margin-bottom: 0.5rem; }
  .timeline-desc { font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 0.875rem; }
  .timeline-link { font-size: 0.8rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .timeline-link:hover { text-decoration: underline; }
</style>
