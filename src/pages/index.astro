---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as HomeAbout }        from '../content/sections/home-about.md';
import { Content as HomeMarketChange } from '../content/sections/home-market-change.md';
import { Content as HomeHowToUse }     from '../content/sections/home-how-to-use.md';
import { Content as DecisionsIntro }   from '../content/sections/decisions-intro.md';
import { Content as DecisionsPatterns }from '../content/sections/decisions-patterns.md';

const phases = [
  {
    n: '1',
    href: '/phases/phase-1',
    label: 'Build on Azure',
    dates: 'Mid-2022 to Early 2023',
    headline: 'Replicate infrastructure on the Microsoft cloud',
    verdict: 'Not viable',
    verdictClass: 'rejected',
    keypoint: 'Costs too high, Myriad database incompatible with Azure SQL.',
  },
  {
    n: '2',
    href: '/phases/phase-2',
    label: 'Buy off-the-shelf',
    dates: 'May 2023 to June 2024',
    headline: 'Replace Myriad with an off-the-shelf product',
    verdict: 'Not affordable',
    verdictClass: 'rejected',
    keypoint: 'Alternatives more expensive, bespoke systems too coupled to Myriad.',
  },
  {
    n: '3',
    href: '/phases/phase-3',
    label: 'Hybrid build and buy',
    dates: 'Late 2023 to Mid-2025',
    headline: 'Build the Harbour and Crane for Single Customer View',
    verdict: 'Pivoted',
    verdictClass: 'pivoted',
    keypoint: 'Architecture proven, but pivoted away from after the Intermedia acquisition of Myriad made CRM agnosticism the priority across the whole business.',
  },
  {
    n: '4',
    href: '/phases/phase-4',
    label: 'CRM agnostic core',
    dates: 'July 2025 to present',
    headline: 'Adapt the architecture for Subscriptions, Memberships, and Charities',
    verdict: 'Paused',
    verdictClass: 'paused',
    keypoint: 'Paused after an underwhelming response to Aimee from Anthem and consistent lack of confidence in the Solutions team.',
  },
  {
    n: 'Now',
    href: '/current-state',
    label: 'Back to Phase 2: RFP for a Myriad replacement',
    dates: 'Late 2025',
    headline: 'Returning to the off-the-shelf path',
    verdict: 'RFP underway',
    verdictClass: 'active',
    keypoint: 'With the 3-year Myriad contract ending and licence costs rising, ESco has initiated an RFP for new subscription management software.',
  },
];

const decisions = [
  {
    decision: 'Reject "all-in with Microsoft" cloud migration',
    options: 'Move entirely to Azure / Dynamics vs. stay on-premise / hybrid',
    reasoning: 'The move was too expensive and required massive disruption to BAU. Legacy Myriad databases lacked the required primary keys for Azure SQL, creating data integrity issues that made the migration technically unsound.',
    when: 'Early 2023',
  },
  {
    decision: 'Delay buying a replacement for Myriad',
    options: 'Buy Affino, Pelcro, AdvantageCS etc. vs. detangle bespoke systems first',
    reasoning: 'Alternative software was more expensive, and ESco\'s bespoke systems were too tightly coupled to Myriad for a clean migration. Detangling was a prerequisite - not just a preference.',
    when: 'June 2024',
  },
  {
    decision: 'Pivot from SCV focus to Subscriptions / CRM-agnostic',
    options: 'Continue the SCV project vs. pivot to core Subscriptions and Memberships',
    reasoning: 'Market demand for SCV was weak. Intermedia\'s acquisition of Gordon and Gotch made decoupling from Myriad an urgent priority for the whole business, not just a single product line.',
    when: 'July 2025',
  },
  {
    decision: 'Proceed with narrow proof of concept using current tools (MongoDB)',
    options: 'Pause to review "build vs buy" for iPaaS and queue tools vs. proceed with MongoDB',
    reasoning: 'Maintaining project momentum was critical. The team accepted the operational risk, noting that underlying tools can be swapped out via standard procurement later if the concept proves viable but MongoDB proves unsuitable under production loads.',
    when: 'Aug / Sept 2025',
  },
];
---

<BaseLayout title="Summary">

  <div class="page-hero">
    <div class="hero-eyebrow">Programme summary</div>
    <h1 class="page-title">ESco Tech Transformation</h1>
    <p class="page-subtitle">A four-year programme of work to understand, explore, and ultimately decide the future technology direction for ESco. This site documents the journey: the hypotheses tested, the evidence gathered, the decisions made, and the path chosen.</p>
  </div>

  <div class="roadmap-wrap">
    <div class="roadmap-inner">
      <h2 class="section-heading roadmap-heading">Programme roadmap</h2>
      <p class="roadmap-intro">Four phases. Each began with a hypothesis, was tested with evidence, and ended with a clear verdict.</p>

      <div class="roadmap">
        <div class="roadmap-line" aria-hidden="true"></div>
        {phases.map(p => (
          <a href={p.href} class={`stop stop-${p.verdictClass}`}>
            <div class="stop-dot"><span>{p.n}</span></div>
            <div class="stop-meta">
              <span class="stop-period">Phase {p.n}</span>
              <span class="stop-dates">{p.dates}</span>
            </div>
            <div class="stop-label">{p.label}</div>
            <div class="stop-headline">{p.headline}</div>
            <div class="stop-keypoint">{p.keypoint}</div>
            <span class={`verdict ${p.verdictClass}`}>{p.verdict}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="page-body">

    <h2 class="section-heading">The changing publishing market</h2>
    <div class="prose"><HomeMarketChange /></div>

    <h2 class="section-heading">Key decisions</h2>
    <div class="prose intro-prose"><DecisionsIntro /></div>

    <div class="decision-list">
      {decisions.map((d, i) => (
        <div class="decision-card">
          <div class="decision-number">{String(i + 1).padStart(2, '0')}</div>
          <div class="decision-body">
            <h3 class="decision-title">{d.decision}</h3>
            <div class="decision-meta"><span class="meta-label">When</span><span class="meta-value">{d.when}</span></div>
            <div class="decision-meta"><span class="meta-label">Options considered</span><span class="meta-value">{d.options}</span></div>
            <div class="decision-reasoning"><span class="meta-label">Reasoning</span><p>{d.reasoning}</p></div>
          </div>
        </div>
      ))}
    </div>

    <h2 class="section-heading">Patterns across the programme</h2>
    <div class="prose"><DecisionsPatterns /></div>

    <h2 class="section-heading">About this programme</h2>
    <div class="prose"><HomeAbout /></div>

    <h2 class="section-heading">How to use this site</h2>
    <div class="prose"><HomeHowToUse /></div>
  </div>

</BaseLayout>

<style>
  /* ── ROADMAP ───────────────────────────────────── */
  .roadmap-wrap {
    background: var(--sidebar-bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 2.5rem 2.5rem 3rem;
    margin: 2.5rem 0 2rem;
  }
  .roadmap-inner { max-width: 1200px; }

  .roadmap-heading { margin-top: 0; border-bottom: 0; padding-bottom: 0; }
  .roadmap-intro {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0.25rem 0 2rem;
  }

  .roadmap {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .roadmap-line {
    position: absolute;
    top: 18px;
    left: 6%;
    right: 6%;
    height: 2px;
    background: var(--border);
    z-index: 0;
  }

  .stop {
    position: relative;
    z-index: 1;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1rem 1.1rem;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .stop:hover {
    border-color: var(--esco-purple);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(91, 33, 182, 0.08);
  }

  .stop-dot {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--esco-purple);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    font-weight: 800;
    margin: -2.05rem auto 0.4rem;
    border: 3px solid var(--sidebar-bg);
  }
  .stop-rejected .stop-dot { background: #16a34a; }
  .stop-chosen   .stop-dot { background: var(--esco-purple); }
  .stop-underway .stop-dot { background: #2563eb; }
  .stop-pivoted  .stop-dot { background: #d97706; }
  .stop-paused   .stop-dot { background: #b91c1c; }
  .stop-active   .stop-dot {
    background: var(--esco-teal);
    width: 44px;
    height: 44px;
    margin-top: -2.4rem;
    font-size: 0.7rem;
    box-shadow: 0 0 0 4px rgba(115, 195, 191, 0.25);
  }

  .stop-meta { display: flex; flex-direction: column; gap: 0.05rem; }
  .stop-period {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }
  .stop-dates { font-size: 0.75rem; color: var(--text-muted); }

  .stop-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--esco-purple-dark);
    line-height: 1.25;
    margin-top: 0.15rem;
  }

  .stop-headline { font-size: 0.8rem; color: var(--text); line-height: 1.4; }
  .stop-keypoint { font-size: 0.75rem; color: var(--text-muted); line-height: 1.5; margin-top: 0.1rem; }
  .stop .verdict { align-self: flex-start; margin-top: 0.4rem; }

  @media (max-width: 1024px) {
    .roadmap { grid-template-columns: repeat(2, 1fr); }
    .roadmap-line { display: none; }
    .stop-dot { margin-top: 0; }
  }
  @media (max-width: 600px) {
    .roadmap-wrap { padding: 2rem 1.25rem; }
    .roadmap { grid-template-columns: 1fr; }
  }

  /* ── DECISIONS ─────────────────────────────────── */
  .intro-prose :global(p) { color: var(--text-muted); }
  .decision-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.5rem; }
  .decision-card { display: flex; gap: 1.25rem; border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem 1.5rem; align-items: flex-start; }
  .decision-number { font-size: 1.5rem; font-weight: 800; color: var(--border); flex-shrink: 0; line-height: 1; padding-top: 0.1rem; min-width: 2rem; }
  .decision-body { flex: 1; }
  .decision-title { font-size: 0.975rem; font-weight: 700; color: var(--text); margin-bottom: 0.75rem; line-height: 1.3; }
  .decision-meta { display: flex; gap: 0.75rem; margin-bottom: 0.4rem; align-items: baseline; flex-wrap: wrap; }
  .decision-reasoning { margin-top: 0.5rem; }
  .decision-reasoning p { margin-bottom: 0; font-size: 0.875rem; color: var(--text-muted); }
  .meta-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); flex-shrink: 0; min-width: 7rem; }
  .meta-value { font-size: 0.875rem; color: var(--text); }
</style>
