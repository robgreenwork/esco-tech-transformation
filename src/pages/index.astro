---
import BaseLayout from '../layouts/BaseLayout.astro';

const phases = [
  {
    number: '1',
    label: 'Build on Azure and the Microsoft stack',
    period: 'Phase 1',
    verdict: 'Not viable',
    verdictClass: 'rejected',
    href: '/phases/phase-1',
    description: 'Explored building a new platform on Azure and the Microsoft technology stack as a route to modernisation.',
  },
  {
    number: '2',
    label: 'Buy an off-the-shelf replacement for Myriad',
    period: 'Phase 2',
    verdict: 'Not affordable',
    verdictClass: 'rejected',
    href: '/phases/phase-2',
    description: 'Assessed the market for an off-the-shelf product that could replace the existing Myriad system outright.',
  },
  {
    number: '3',
    label: 'Hybrid build and buy -- interchangeable adaptable infrastructure',
    period: 'Phase 3',
    verdict: 'Chosen path',
    verdictClass: 'chosen',
    href: '/phases/phase-3',
    description: 'Developed a hybrid approach: buying best-of-breed components where available and building where necessary, on an adaptable, interchangeable infrastructure.',
  },
];
---

<BaseLayout title="Overview">

  <h1 class="page-title">ESco Tech Transformation</h1>
  <p class="page-subtitle">A four-year programme of work to understand, explore, and ultimately decide the future technology direction for ESco. This site documents the journey -- the hypotheses tested, the evidence gathered, the decisions made, and the path chosen.</p>

  <!-- PROGRAMME OVERVIEW -->
  <h2 class="section-heading">About this programme</h2>
  <!-- PASTE: programme-overview from NotebookLM -->
  <div class="placeholder">
    <span><strong>Content pending: programme overview.</strong> A brief description of why this programme was initiated, the scope of the challenge, and who was involved.</span>
  </div>

  <!-- VISUAL TIMELINE -->
  <h2 class="section-heading" style="margin-top: 2.5rem;">The three phases</h2>
  <p class="intro-text">The programme moved through three distinct phases. Each phase began with a hypothesis, was tested with evidence, and ended with a clear verdict that shaped what came next.</p>

  <div class="timeline">
    {phases.map((phase, i) => (
      <div class="timeline-item">
        <div class="timeline-connector">
          <div class="timeline-dot">
            <span>{phase.number}</span>
          </div>
          {i < phases.length - 1 && <div class="timeline-line" />}
        </div>
        <div class="timeline-card">
          <div class="timeline-card-header">
            <span class="phase-label">{phase.period}</span>
            <span class={`verdict ${phase.verdictClass}`}>{phase.verdict}</span>
          </div>
          <h3 class="timeline-title">{phase.label}</h3>
          <p class="timeline-desc">{phase.description}</p>
          <a href={phase.href} class="timeline-link">Read phase detail <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    ))}
  </div>

  <!-- HOW TO USE THIS SITE -->
  <h2 class="section-heading">How to use this site</h2>
  <p class="body-text">Each phase has its own page covering: the period it ran, the hypothesis being tested, what was explored, what was found, the decision reached, and the key supporting documents. Use the navigation on the left to move between sections.</p>
  <p class="body-text">The <a href="/architecture">Architecture</a> page documents the technical choices made. <a href="/decisions">Decisions and Rationale</a> captures the key forks in the road. <a href="/current-state">Current State</a> describes where the programme sits at the point of handover. <a href="/reference">Reference</a> collects supporting materials.</p>

</BaseLayout>

<style>
  .intro-text {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    line-height: 1.7;
  }
  .body-text {
    font-size: 0.9375rem;
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 0.875rem;
  }
  .body-text a { color: var(--accent); }

  /* TIMELINE */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 2.5rem;
  }

  .timeline-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .timeline-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding-top: 1.125rem;
  }

  .timeline-dot {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
    z-index: 1;
    position: relative;
  }

  .timeline-line {
    width: 2px;
    flex: 1;
    background: var(--border);
    min-height: 2rem;
  }

  .timeline-card {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
    background: #fff;
  }

  .timeline-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .phase-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .timeline-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .timeline-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 0.875rem;
  }

  .timeline-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .timeline-link:hover { text-decoration: underline; }
</style>
