---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as DecisionsIntro }   from '../content/sections/decisions-intro.md';

// Each item is a 'phase', 'decision', or 'event', interleaved chronologically
const timeline = [
  {
    type: 'event',
    when: 'May 2022',
    label: 'Architecture review commissioned',
    detail: 'ESco commissioned Ivan Teage (Harmonic Action Technologies) to carry out an external review of the technology architecture and recommend how to evolve it for the next decade. This review was the starting point for the whole programme.',
    href: '/architecture',
  },
  {
    type: 'phase',
    n: '1',
    period: 'Phase 1',
    href: '/phases/phase-1',
    label: 'Build on Azure',
    dates: 'Mid-2022 to Early 2023',
    headline: 'Replicate infrastructure on the Microsoft cloud',
    verdict: 'Not viable',
    verdictClass: 'rejected',
    keypoint: 'Costs too high, Myriad database incompatible with Azure SQL.',
  },
  {
    type: 'decision',
    when: 'Early 2023',
    decision: 'Reject "all-in with Microsoft" cloud migration',
    options: 'Move entirely to Azure / Dynamics vs. stay on-premise / hybrid',
    reasoning: 'The move was too expensive and required massive disruption to BAU. Legacy Myriad databases lacked the required primary keys for Azure SQL, creating data integrity issues that made the migration technically unsound.',
  },
  {
    type: 'phase',
    n: '2',
    period: 'Phase 2',
    href: '/phases/phase-2',
    label: 'Buy off-the-shelf',
    dates: 'May 2023 to June 2024',
    headline: 'Replace Myriad with an off-the-shelf product',
    verdict: 'Not affordable',
    verdictClass: 'rejected',
    keypoint: 'Alternatives more expensive, bespoke systems too coupled to Myriad.',
  },
  {
    type: 'decision',
    when: 'June 2024',
    decision: 'Delay buying a replacement for Myriad',
    options: 'Buy Affino, Pelcro, AdvantageCS etc. vs. detangle bespoke systems first',
    reasoning: 'Alternative software was more expensive, and ESco\'s bespoke systems were too tightly coupled to Myriad for a clean migration. Detangling was a prerequisite, not just a preference.',
  },
  {
    type: 'phase',
    n: '3',
    period: 'Phase 3',
    href: '/phases/phase-3',
    label: 'Hybrid build and buy',
    dates: 'Late 2023 to Mid-2025',
    headline: 'Build the Harbour and Crane for Single Customer View',
    verdict: 'Pivoted',
    verdictClass: 'pivoted',
    keypoint: 'Architecture proven, but pivoted away from after the Intermedia acquisition of Myriad made CRM agnosticism the priority across the whole business.',
  },
  {
    type: 'decision',
    when: 'July 2025',
    decision: 'Pivot from SCV focus to Subscriptions / CRM-agnostic',
    options: 'Continue the SCV project vs. pivot to core Subscriptions and Memberships',
    reasoning: 'Market demand for SCV was weak. Intermedia\'s acquisition of Gordon and Gotch made decoupling from Myriad an urgent priority for the whole business, not just a single product line.',
  },
  {
    type: 'phase',
    n: '4',
    period: 'Phase 4',
    href: '/phases/phase-4',
    label: 'CRM agnostic core',
    dates: 'July 2025 to present',
    headline: 'Adapt the architecture for Subscriptions, Memberships, and Charities',
    verdict: 'Paused',
    verdictClass: 'paused',
    keypoint: 'Paused after an underwhelming response to Aimee from Anthem and consistent lack of confidence in the Solutions team.',
  },
  {
    type: 'decision',
    when: 'Aug / Sept 2025',
    decision: 'Proceed with narrow proof of concept using current tools (MongoDB)',
    options: 'Pause to review "build vs buy" for iPaaS and queue tools vs. proceed with MongoDB',
    reasoning: 'Maintaining project momentum was critical. The team accepted the operational risk, noting that underlying tools can be swapped out via standard procurement later if the concept proves viable but MongoDB proves unsuitable under production loads.',
  },
  {
    type: 'event',
    when: 'September 2025',
    label: 'Intermedia acquires Myriad',
    detail: 'Intermedia acquired Myriad, ESco\'s core subscription management platform. This materially changed the landscape, making CRM agnosticism an urgent priority across the whole business and accelerating the decision to run a formal RFP for a replacement.',
  },
  {
    type: 'event',
    when: 'October 2025',
    label: 'Developers restructured into Solutions Team',
    detail: 'Greg and Darren were moved out of developer roles and into a newly defined Solutions Team, shifting their mandate from bespoke software development to finding and configuring the right tools and systems to solve business problems. See the People section for full context.',
    href: '/people-context',
  },
  {
    type: 'phase',
    n: 'Now',
    period: 'Current state',
    href: '/current-state',
    label: 'Back to Phase 2: RFP for a Myriad replacement',
    dates: 'Late 2025',
    headline: 'Returning to the off-the-shelf path',
    verdict: 'RFP underway',
    verdictClass: 'active',
    keypoint: 'With the 3-year Myriad contract ending and licence costs rising, ESco has initiated an RFP for new subscription management software.',
  },
];
---

<BaseLayout title="Summary">

  <div class="page-hero">
    <div class="hero-eyebrow">Programme summary</div>
    <h1 class="page-title">A programme of work to understand explore and ultimately decide the future technology direction for ESco.</h1>
    <p class="page-subtitle">This site documents the journey: the hypotheses tested the evidence gathered the decisions made and the path chosen.</p>
  </div>

  <div class="wide-section">
    <h2 class="section-heading">About ESco and this programme</h2>
    <div class="prose">
      <p>ESco is a publishing services bureau offering subscription management, customer service, and eCommerce solutions. For many years the business relied heavily on Myriad as its core subscription management database, a single point of failure that had accumulated significant technical debt, an outdated interface, and deeply embedded bespoke integrations that made it slow to adapt. When the company behind Myriad (Gordon and Gotch) was acquired by Intermedia in 2025, the urgency to reduce dependency on any single CRM became critical. The Tech Transformation programme was initiated to find a path to a CRM-agnostic architecture: one where ESco could plug in new systems, cut operating costs, improve scalability, and confidently price and sell services with healthy margins.</p>
    </div>
  </div>

  <div class="wide-section">
    <h2 class="section-heading">Programme roadmap and key decisions</h2>
    <div class="prose"><DecisionsIntro /></div>
    <div class="timeline">
      {timeline.map((item) => (
        <>
          {item.type === 'phase' && (
            <a href={item.href} class={`tl-phase tl-phase-${item.verdictClass}`}>
              <div class="tl-spine">
                <div class={`tl-dot tl-dot-${item.verdictClass}`}><span>{item.n}</span></div>
                <div class="tl-spine-date">{item.dates}</div>
                <div class="tl-line"></div>
              </div>
              <div class="tl-card">
                <div class="tl-card-meta">
                  <span class="tl-period">{item.period}</span>
                  <span class={`verdict ${item.verdictClass}`}>{item.verdict}</span>
                </div>
                <div class="tl-label">{item.label}</div>
                <div class="tl-headline">{item.headline}</div>
                <div class="tl-keypoint">{item.keypoint}</div>
              </div>
            </a>
          )}
          {item.type === 'decision' && (
            <div class="tl-decision">
              <div class="tl-spine">
                <div class="tl-decision-dot"></div>
                <div class="tl-spine-date">{item.when}</div>
                <div class="tl-line"></div>
              </div>
              <div class="tl-decision-card">
                <div class="tl-decision-when">{item.when}</div>
                <div class="tl-decision-label">Decision: {item.decision}</div>
                <div class="tl-decision-options"><span class="meta-label">Options considered</span> {item.options}</div>
                <div class="tl-decision-reasoning"><span class="meta-label">Reasoning</span> {item.reasoning}</div>
              </div>
            </div>
          )}
          {item.type === 'event' && (
            <div class="tl-event">
              <div class="tl-spine">
                <div class="tl-event-dot"></div>
                <div class="tl-spine-date">{item.when}</div>
                <div class="tl-line"></div>
              </div>
              {item.href ? (
                <a href={item.href} class="tl-event-card tl-event-card-link">
                  <div class="tl-event-when">{item.when}</div>
                  <div class="tl-event-label">{item.label}</div>
                  <div class="tl-event-detail">{item.detail}</div>
                </a>
              ) : (
                <div class="tl-event-card">
                  <div class="tl-event-when">{item.when}</div>
                  <div class="tl-event-label">{item.label}</div>
                  <div class="tl-event-detail">{item.detail}</div>
                </div>
              )}
            </div>
          )}
        </>
      ))}
    </div>
  </div>
  </div>

</BaseLayout>

<style>
  /* ── HERO title as subtitle ───────────────────────── */
  .page-hero .page-title {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-muted);
    line-height: 1.6;
    letter-spacing: 0;
  }

  /* ── WIDE SECTIONS (about + timeline) ─────────────── */
  .wide-section {
    padding: 2.5rem 2rem 2.5rem 2.5rem;
    max-width: 1210px;
  }

  /* ── TIMELINE ─────────────────────────────────────── */
  .timeline {
    display: flex;
    flex-direction: column;
  }

  /* shared spine column */
  .tl-spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 90px;
    flex-shrink: 0;
  }
  .tl-spine-date {
    font-size: 0.6rem;
    color: var(--text-faint);
    text-align: center;
    line-height: 1.3;
    margin-top: 0.2rem;
    padding: 0 0.25rem;
  }
  .tl-line {
    flex: 1;
    width: 2px;
    background: var(--border);
    min-height: 0.75rem;
  }
  /* hide the trailing line on the last item */
  .timeline > *:last-child .tl-line { display: none; }

  /* ── Phase rows ── */
  .tl-phase {
    display: flex;
    gap: 1rem;
    text-decoration: none;
    color: var(--text);
    align-items: stretch;
  }
  .tl-phase:hover .tl-card {
    border-color: var(--esco-purple);
    box-shadow: 0 4px 16px rgba(91, 33, 182, 0.08);
    transform: translateX(2px);
  }

  .tl-dot {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--esco-purple);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 800;
    flex-shrink: 0;
    border: 3px solid var(--sidebar-bg);
    position: relative;
    z-index: 1;
  }
  .tl-dot-rejected  { background: #16a34a; }
  .tl-dot-pivoted   { background: #d97706; }
  .tl-dot-paused    { background: #b91c1c; }
  .tl-dot-active    {
    background: var(--esco-teal);
    box-shadow: 0 0 0 4px rgba(115, 195, 191, 0.25);
    width: 44px;
    height: 44px;
    font-size: 0.65rem;
  }

  .tl-card {
    flex: 1;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .tl-phase-active .tl-card {
    border: 2px solid var(--esco-teal);
    box-shadow: 0 6px 20px -6px rgba(115, 195, 191, 0.4);
  }

  .tl-card-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .tl-period {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }
  .tl-phase-active .tl-period { color: var(--esco-purple); }
  .tl-dates { font-size: 0.75rem; color: var(--text-muted); }
  .tl-label {
    font-size: 0.975rem;
    font-weight: 700;
    color: var(--esco-purple-dark);
    line-height: 1.25;
  }
  .tl-headline { font-size: 0.825rem; color: var(--text); line-height: 1.45; }
  .tl-keypoint { font-size: 0.775rem; color: var(--text-muted); line-height: 1.5; }

  /* ── Decision rows ── */
  .tl-decision {
    display: flex;
    gap: 1rem;
    align-items: stretch;
  }

  .tl-decision-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--esco-purple);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    margin: 0 37px;
  }

  /* ── Event rows ── */
  .tl-event {
    display: flex;
    gap: 1rem;
    align-items: stretch;
  }
  .tl-event-dot {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--esco-teal);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    margin: 0 38px;
  }
  .tl-event-card {
    flex: 1;
    background: #f0fafa;
    border: 1px solid rgba(115, 195, 191, 0.4);
    border-left: 3px solid var(--esco-teal);
    border-radius: 6px;
    padding: 0.7rem 1rem;
    margin-bottom: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--text);
  }
  .tl-event-card-link:hover {
    border-color: var(--esco-teal);
    box-shadow: 0 2px 10px rgba(115, 195, 191, 0.2);
  }
  .tl-event-when {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--esco-teal);
  }
  .tl-event-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }
  .tl-event-detail {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .tl-decision-card {
    flex: 1;
    background: var(--sidebar-bg);
    border: 1px solid var(--border);
    border-left: 3px solid var(--esco-purple);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .tl-decision-when {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }
  .tl-decision-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }
  .tl-decision-options,
  .tl-decision-reasoning {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .meta-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin-right: 0.4rem;
  }

  @media (max-width: 768px) {
    .timeline-wrap { margin: 0 0 2.5rem; }
  }
  @media (max-width: 600px) {
    .tl-spine { width: 56px; }
    .tl-dot { width: 32px; height: 32px; font-size: 0.75rem; }
    .tl-dot-active { width: 36px; height: 36px; }
    .tl-decision-dot { margin: 0 20px; }
    .tl-event-dot { margin: 0 21px; }
  }
</style>
