---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Overview">

  <!-- HERO -->
  <div class="hero">
    <div class="hero-eyebrow">2020 – 2024 · ESco Technology</div>
    <h1>Tech Transformation<br/><span>Programme</span></h1>
    <p>A four-year programme to modernise the technology, people, and delivery culture at ESco — from the original mandate through to outcomes, lessons, and handover.</p>
    <div class="hero-chips">
      <span>4 Years</span>
      <span>People · Delivery · Architecture · Strategy</span>
      <span>Rob Green</span>
    </div>
  </div>

  <!-- THE PROBLEM -->
  <section class="section">
    <h2 class="section-title">The Problem We Were Solving</h2>
    <div class="problem-grid">
      <div class="problem-card">
        <div class="problem-icon">🏗️</div>
        <h3>Complex Tech Footprint</h3>
        <p>A mixture of internally built systems needing constant improvement, 3rd-party tools becoming end-of-life or underutilised, and technology agency partnerships that needed active management.</p>
      </div>
      <div class="problem-card">
        <div class="problem-icon">🚧</div>
        <h3>Delivery Blockage</h3>
        <p>Technology delivery was blocked by team capacity, competing priorities, insufficient processes and tools — creating tension between the tech team and the rest of the company.</p>
      </div>
      <div class="problem-card">
        <div class="problem-icon">👤</div>
        <h3>Recruitment Challenges</h3>
        <p>Unsuccessful hiring due to unclear roles, expensive processes, and retention concerns. Single points of failure and bottlenecks in the team structure created fragility.</p>
      </div>
      <div class="problem-card">
        <div class="problem-icon">⚡</div>
        <h3>Reactive, Not Proactive</h3>
        <p>The strategy, infrastructure decisions, and technology investments ahead were pivotal. ESco needed to move from reactive firefighting to proactive, confident technology leadership.</p>
      </div>
    </div>
  </section>

  <!-- OUTCOMES -->
  <section class="section outcomes-section">
    <h2 class="section-title" style="color:white; --line-color: rgba(255,255,255,0.2)">The Four Outcomes</h2>
    <p class="outcomes-intro">What this programme committed to deliver</p>
    <div class="outcomes-grid">
      <div class="outcome-card">
        <div class="outcome-num">01</div>
        <h3>Invest in the right things</h3>
        <p>Identify where the most important things for ESco Tech to invest in are — now, next, and future — so we're not wasting time and money delivering the wrong thing.</p>
      </div>
      <div class="outcome-card">
        <div class="outcome-num">02</div>
        <h3>Sustainable infrastructure</h3>
        <p>Build ESco Tech infrastructure in a more sustainable way — less exposed to risk from external factors and less reliant on key pieces of software.</p>
      </div>
      <div class="outcome-card">
        <div class="outcome-num">03</div>
        <h3>Deliver faster</h3>
        <p>Make the ESco Tech team deliver the next most important thing quicker — getting the most out of the team and having the biggest impact for the investment.</p>
      </div>
      <div class="outcome-card">
        <div class="outcome-num">04</div>
        <h3>Ignite the team</h3>
        <p>Ignite the ESco Technology team and attract the right people to facilitate the change — reducing staff turnover risk and making the team deliver more impact.</p>
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="section">
    <h2 class="section-title">The Approach</h2>
    <div class="approach-grid">
      <div class="approach-card">
        <div class="approach-icon">🌱</div>
        <div>
          <h3>Sustainable change</h3>
          <p>Working together to identify and solve problems — leaving the team with skills, tools, and confidence to keep iterating for more value over time.</p>
        </div>
      </div>
      <div class="approach-card">
        <div class="approach-icon">🤝</div>
        <div>
          <h3>Bridge the gap</h3>
          <p>Improving interactions between technology and the rest of the organisation by creating the right environment. Technology change is a team sport.</p>
        </div>
      </div>
      <div class="approach-card">
        <div class="approach-icon">📚</div>
        <div>
          <h3>Learning through doing</h3>
          <p>Not training — guiding the team to deliver value while building the skills, knowledge, and confidence to do it alone next time.</p>
        </div>
      </div>
      <div class="approach-card">
        <div class="approach-icon">🎯</div>
        <div>
          <h3>Starts with leadership</h3>
          <p>Real change only happens when the leadership team are involved throughout. This can't be someone else's responsibility.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NAV CARDS -->
  <section class="section">
    <h2 class="section-title">Explore the Programme</h2>
    <div class="nav-grid">
      <a href="/timeline" class="nav-card">
        <div class="nav-card-icon" style="background:#EBF8F7; color:#3DBFB5">📅</div>
        <div>
          <h3>Timeline</h3>
          <p>Key milestones, decisions, and pivots from start to finish.</p>
        </div>
        <div class="nav-card-arrow">→</div>
      </a>
      <a href="/phases/discovery" class="nav-card">
        <div class="nav-card-icon" style="background:#F3EEF9; color:#8B4EC4">🗂</div>
        <div>
          <h3>Phases</h3>
          <p>People · Delivery · Architecture · Strategy — what was set out, what happened, what was learned.</p>
        </div>
        <div class="nav-card-arrow">→</div>
      </a>
      <a href="/roles" class="nav-card">
        <div class="nav-card-icon" style="background:#FEF0EF; color:#F07870">👥</div>
        <div>
          <h3>Roles &amp; Responsibilities</h3>
          <p>Who was involved and what they owned.</p>
        </div>
        <div class="nav-card-arrow">→</div>
      </a>
      <a href="/lessons" class="nav-card">
        <div class="nav-card-icon" style="background:#F3EEF9; color:#5E2589">💡</div>
        <div>
          <h3>Lessons Learned</h3>
          <p>Honest reflections on what worked and what we'd do differently.</p>
        </div>
        <div class="nav-card-arrow">→</div>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .hero {
    background: linear-gradient(135deg, var(--purple-dark) 0%, var(--purple) 60%, var(--purple-light) 100%);
    border-radius: var(--radius-lg);
    padding: 3.5rem 3rem;
    margin-bottom: 3.5rem;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 300px; height: 300px;
    border-radius: 50%;
    background: rgba(61,191,181,0.15);
  }
  .hero::after {
    content: '';
    position: absolute;
    bottom: -80px; left: 40%;
    width: 250px; height: 250px;
    border-radius: 50%;
    background: rgba(255,255,255,0.05);
  }
  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-light);
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    color: white;
    position: relative;
    z-index: 1;
  }
  .hero h1 span { color: var(--teal-light); }
  .hero p {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.8);
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
  }
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    position: relative;
    z-index: 1;
  }
  .hero-chips span {
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.25);
    color: white;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* SECTION */
  .section { margin-bottom: 3.5rem; }

  /* PROBLEM GRID */
  .problem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .problem-card {
    background: white;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: all 0.2s;
  }
  .problem-card:hover { border-color: var(--purple-light); box-shadow: 0 4px 20px rgba(94,37,137,0.08); }
  .problem-icon { font-size: 1.75rem; margin-bottom: 0.75rem; }
  .problem-card h3 { font-weight: 700; font-size: 0.95rem; color: var(--purple-dark); margin-bottom: 0.5rem; }
  .problem-card p { font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; }

  /* OUTCOMES */
  .outcomes-section {
    background: linear-gradient(135deg, var(--purple) 0%, var(--purple-dark) 100%);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    margin-left: -0.5rem;
    margin-right: -0.5rem;
  }
  .outcomes-section .section-title { color: white; }
  .outcomes-section .section-title::after { background: rgba(255,255,255,0.2); }
  .outcomes-intro {
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
    margin-top: -0.75rem;
    margin-bottom: 1.5rem;
  }
  .outcomes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .outcome-card {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius);
    padding: 1.5rem;
    backdrop-filter: blur(4px);
  }
  .outcome-num {
    font-size: 2rem;
    font-weight: 800;
    color: var(--teal-light);
    line-height: 1;
    margin-bottom: 0.5rem;
    opacity: 0.8;
  }
  .outcome-card h3 { font-weight: 700; font-size: 0.95rem; color: white; margin-bottom: 0.5rem; }
  .outcome-card p { font-size: 0.82rem; color: rgba(255,255,255,0.75); line-height: 1.55; }

  /* APPROACH */
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .approach-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--grey-bg);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .approach-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 0.1rem; }
  .approach-card h3 { font-weight: 700; font-size: 0.9rem; color: var(--purple-dark); margin-bottom: 0.35rem; }
  .approach-card p { font-size: 0.82rem; color: var(--text-muted); line-height: 1.55; }

  /* NAV CARDS */
  .nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .nav-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    background: white;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s;
    position: relative;
  }
  .nav-card:hover {
    border-color: var(--purple);
    box-shadow: 0 8px 30px rgba(94,37,137,0.12);
    transform: translateY(-2px);
  }
  .nav-card-icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }
  .nav-card h3 { color: var(--purple-dark); font-weight: 700; font-size: 0.95rem; margin-bottom: 0.3rem; }
  .nav-card p { color: var(--text-muted); font-size: 0.82rem; line-height: 1.5; }
  .nav-card-arrow {
    position: absolute;
    top: 1.25rem; right: 1.25rem;
    color: var(--purple-light);
    font-size: 1.1rem;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .nav-card:hover .nav-card-arrow { opacity: 1; }
</style>
