---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as Complete }       from '../content/sections/current-state-complete.md';
import { Content as InProgress }     from '../content/sections/current-state-in-progress.md';
import { Content as Parked }         from '../content/sections/current-state-parked.md';
import { Content as Handover }       from '../content/sections/current-state-handover.md';
import { Content as RiskMongo }      from '../content/sections/current-state-risk-mongo.md';
import { Content as RiskCrane }      from '../content/sections/current-state-risk-crane.md';
import { Content as RiskIntermedia } from '../content/sections/current-state-risk-intermedia.md';
import { Content as RiskAimee }      from '../content/sections/current-state-risk-aimee.md';
---

<BaseLayout title="Current State">

  <div class="page-hero">
    <div class="hero-eyebrow">Status at handover</div>
    <h1 class="page-title">Current State</h1>
    <p class="page-subtitle">Where the programme stands at the point of handover, what is complete, what is in progress, and what remains open.</p>
  </div>

  <div class="page-body">

  <h2 class="section-heading">What is complete</h2>
  <div class="prose"><Complete /></div>

  <h2 class="section-heading">What is in progress</h2>
  <div class="prose"><InProgress /></div>

  <h2 class="section-heading">What has been parked</h2>
  <div class="prose"><Parked /></div>

  <h2 class="section-heading">Open questions and risks</h2>

  <div class="risk-item">
    <div class="risk-title">MongoDB as a queue system</div>
    <div class="prose"><RiskMongo /></div>
  </div>
  <div class="risk-item">
    <div class="risk-title">Build or buy for the Crane</div>
    <div class="prose"><RiskCrane /></div>
  </div>
  <div class="risk-item">
    <div class="risk-title">Intermedia's roadmap for Myriad</div>
    <div class="prose"><RiskIntermedia /></div>
  </div>
  <div class="risk-item">
    <div class="risk-title">Cloud deployment blockers for Aimee</div>
    <div class="prose"><RiskAimee /></div>
  </div>

  <h2 class="section-heading">Handover notes</h2>
  <div class="prose"><Handover /></div>

  </div>
</BaseLayout>

<style>
  .risk-item { border: 1px solid var(--border); border-radius: 8px; padding: 1.1rem 1.25rem; margin-bottom: 0.875rem; }
  .risk-title { font-size: 0.9rem; font-weight: 700; color: var(--text); margin-bottom: 0.5rem; }
  .risk-item :global(p) { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0; line-height: 1.65; }
</style>
