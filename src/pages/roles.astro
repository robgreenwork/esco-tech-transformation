---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Roles & Responsibilities" description="Who was involved and what they owned across the ESco Tech Transformation programme.">
  <div class="page-header">
    <div class="label">People &amp; Structure</div>
    <h1>Roles &amp; Responsibilities</h1>
    <p>Who was involved across the four-year programme, what each person or team owned, and how the structure evolved.</p>
  </div>

  <!-- ROB'S ROLE -->
  <section style="margin-bottom: 2.5rem;">
    <h2 class="section-title">Programme Lead</h2>
    <div class="bio-card">
      <div class="bio-avatar">RG</div>
      <div class="bio-content">
        <div class="bio-name">Rob Green</div>
        <div class="bio-title">Technology Strategy &amp; Delivery Expert</div>
        <p>
          Rob builds Technology and Innovation teams of all shapes and sizes — an expert at thinking about the whole system, ensuring teams are aligned to clear business goals, delivering at pace, and have the right people in them.
        </p>
        <p style="margin-top:0.75rem">
          Background spans running a Delivery department in a large complex organisation, transforming established teams, and building Product and Engineering functions in fast-growing startups.
        </p>
        <div class="bio-principles">
          <div class="principle">Think BIG, start small</div>
          <div class="principle">Show not tell</div>
          <div class="principle">Design. Build. Test. Learn. Repeat.</div>
          <div class="principle">Move fast with a stable infrastructure</div>
        </div>
      </div>
    </div>
  </section>

  <!-- WORKSTREAMS -->
  <section style="margin-bottom: 2.5rem;">
    <h2 class="section-title">The Four Workstreams</h2>
    <div class="workstream-grid">
      <a href="/phases/discovery" class="ws-role-card">
        <div class="ws-icon" style="background:#EBF8F7; color:#3DBFB5">👥</div>
        <div>
          <h3>People</h3>
          <p>Coaching the existing tech team, leadership involvement, developing skills and retaining talent.</p>
        </div>
      </a>
      <a href="/phases/foundation" class="ws-role-card">
        <div class="ws-icon" style="background:#F3EEF9; color:#8B4EC4">🚀</div>
        <div>
          <h3>Delivery</h3>
          <p>Agile delivery model, Technology Delivery Specialist role, process improvement.</p>
        </div>
      </a>
      <a href="/phases/delivery" class="ws-role-card">
        <div class="ws-icon" style="background:#FEF0EF; color:#F07870">🏗️</div>
        <div>
          <h3>Tech Architecture</h3>
          <p>Solutions architecture review, current footprint mapping, target architecture definition.</p>
        </div>
      </a>
      <a href="/phases/scale" class="ws-role-card">
        <div class="ws-icon" style="background:#F3EEF9; color:#5E2589">🎯</div>
        <div>
          <h3>Tech Strategy</h3>
          <p>Vision and goals, SMART objectives, Technology Roadmap, product portfolio assessment.</p>
        </div>
      </a>
    </div>
  </section>

  <!-- OTHER ROLES PLACEHOLDER -->
  <section>
    <h2 class="section-title">ESco Team &amp; Stakeholders</h2>
    <div class="placeholder-notice">Add the ESco leadership team, tech team members, and any external partners or agencies involved below.</div>
    <div class="roles-grid">
      <div class="role-card">
        <div class="role-title">Leadership Sponsor</div>
        <div class="role-name">[Name]</div>
        <p>[Placeholder — role in the programme, decisions owned, level of involvement.]</p>
      </div>
      <div class="role-card">
        <div class="role-title">Technology Delivery Specialist</div>
        <div class="role-name">[Name]</div>
        <p>[Placeholder — when they joined, what they owned, how they evolved the delivery process.]</p>
      </div>
      <div class="role-card">
        <div class="role-title">Solutions Architect</div>
        <div class="role-name">[Name / Agency]</div>
        <p>[Placeholder — engagement scope, outputs, relationship with the tech team.]</p>
      </div>
      <div class="role-card">
        <div class="role-title">Tech Team</div>
        <div class="role-name">[Names]</div>
        <p>[Placeholder — existing team members, their roles, skill development over the programme.]</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* BIO CARD */
  .bio-card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    background: var(--purple-tint);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }
  .bio-avatar {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: var(--purple);
    color: white;
    font-weight: 800;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bio-name { font-size: 1.15rem; font-weight: 800; color: var(--purple-dark); }
  .bio-title { font-size: 0.8rem; font-weight: 600; color: var(--teal); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem; }
  .bio-content p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; }
  .bio-principles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .principle {
    background: white;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--purple);
  }

  /* WORKSTREAM GRID */
  .workstream-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
    margin-bottom: 0;
  }
  .ws-role-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    background: white;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s;
  }
  .ws-role-card:hover { border-color: var(--purple); box-shadow: 0 4px 20px rgba(94,37,137,0.08); }
  .ws-icon {
    width: 44px; height: 44px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; flex-shrink: 0;
  }
  .ws-role-card h3 { font-size: 0.9rem; font-weight: 700; color: var(--purple-dark); margin-bottom: 0.3rem; }
  .ws-role-card p { font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; }

  /* ROLES GRID */
  .roles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .role-card {
    background: white;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .role-title {
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--teal); margin-bottom: 0.25rem;
  }
  .role-name { font-size: 1rem; font-weight: 700; color: var(--purple-dark); margin-bottom: 0.5rem; }
  .role-card p { color: var(--text-muted); font-size: 0.85rem; line-height: 1.55; }
</style>
