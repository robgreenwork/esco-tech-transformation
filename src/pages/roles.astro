---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Roles & Responsibilities" description="Who was involved and what they owned across the Esco Tech Transformation programme.">
  <div class="page-header">
    <div class="label">People &amp; Structure</div>
    <h1>Roles &amp; Responsibilities</h1>
    <p>Who was involved across the four-year programme, what each person or team owned, and how the structure evolved.</p>
  </div>

  <div class="placeholder-notice">
    Add roles, teams, and responsibilities below. You can organise by team, by phase, or by function — whatever makes most sense for your programme structure.
  </div>

  <!-- Example structure — adapt freely -->
  <section style="margin-bottom: 2rem;">
    <h2 style="margin-bottom: 1rem; font-size: 1.2rem;">Programme Leadership</h2>
    <div class="grid-2">
      <div class="card role-card">
        <div class="role-title">Programme Director</div>
        <div class="role-name">Rob Green</div>
        <p>[Placeholder — overall accountabilty, stakeholder management, programme strategy.]</p>
      </div>
      <div class="card role-card">
        <div class="role-title">[Role]</div>
        <div class="role-name">[Name]</div>
        <p>[Placeholder]</p>
      </div>
    </div>
  </section>

  <section style="margin-bottom: 2rem;">
    <h2 style="margin-bottom: 1rem; font-size: 1.2rem;">Technology &amp; Engineering</h2>
    <div class="grid-2">
      <div class="card role-card">
        <div class="role-title">[Role]</div>
        <div class="role-name">[Name]</div>
        <p>[Placeholder]</p>
      </div>
    </div>
  </section>

  <section style="margin-bottom: 2rem;">
    <h2 style="margin-bottom: 1rem; font-size: 1.2rem;">Business &amp; Change</h2>
    <div class="grid-2">
      <div class="card role-card">
        <div class="role-title">[Role]</div>
        <div class="role-name">[Name]</div>
        <p>[Placeholder]</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .role-card { }
  .role-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.25rem;
  }
  .role-name {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
</style>
