---
// Set to false when the site is ready to publish
const isDraft = true;

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'ESco technology transformation programme handover.' } = Astro.props;

const nav = [
  {
    items: [
      { href: '/', label: 'Overview' },
    ],
  },
  {
    label: 'Phases',
    items: [
      { href: '/phases/phase-1', label: 'Phase 1 -- Azure / Microsoft' },
      { href: '/phases/phase-2', label: 'Phase 2 -- Off the shelf' },
      { href: '/phases/phase-3', label: 'Phase 3 -- Hybrid build and buy' },
    ],
  },
  {
    items: [
      { href: '/architecture',  label: 'Architecture' },
      { href: '/decisions',     label: 'Decisions and Rationale' },
      { href: '/current-state', label: 'Current State' },
      { href: '/reference',     label: 'Reference' },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} -- ESco Tech Transformation</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --font:            'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

        /* ESco brand colours (exact from esco.co.uk) */
        --esco-purple:       oklch(0.408 0.157 313.5);
        --esco-purple-dark:  oklch(0.3529 0.131 313.78);
        --esco-teal:         oklch(0.7193 0.123 193.41);
        --esco-teal-light:   oklch(0.8698 0.074 194.81);

        /* Layout */
        --bg:              #ffffff;
        --sidebar-bg:      #f8f9fa;
        --text:            #1c1917;
        --text-muted:      #6b7280;
        --text-faint:      #9ca3af;
        --border:          #e5e7eb;
        --accent:          var(--esco-purple);
        --accent-light:    oklch(0.96 0.02 313.5);

        /* Status colours */
        --banner-bg:       #fef9c3;
        --banner-border:   #fde047;
        --banner-text:     #713f12;
        --ph-bg:           #fefce8;
        --ph-border:       #fde047;
        --ph-text:         #854d0e;
        --chosen-bg:       #dcfce7;
        --chosen-text:     #14532d;
        --rejected-bg:     #f1f5f9;
        --rejected-text:   #475569;

        /* Dimensions */
        --topbar-h:        64px;
        --banner-h:        36px;
        --sidebar-w:       248px;
        --header-h:        calc(var(--topbar-h) + var(--banner-h));
      }

      html { font-size: 16px; }

      body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      /* ═══════════════════════════════════════════
         TOP BAR  —  full-width ESco-branded header
      ══════════════════════════════════════════════ */
      .topbar {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: var(--topbar-h);
        background: var(--esco-purple);
        display: flex;
        align-items: center;
        padding: 0 1.5rem 0 0;
        z-index: 300;
        gap: 0;
      }

      /* Sidebar-width logo block */
      .topbar-logo {
        width: var(--sidebar-w);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        padding: 0 1.25rem;
        height: 100%;
        text-decoration: none;
        border-right: 1px solid rgba(255,255,255,0.12);
        gap: 0.75rem;
      }

      /* SVG wordmark */
      .esco-wordmark {
        display: flex;
        flex-direction: column;
        gap: 0;
        line-height: 1;
      }
      .esco-wordmark .wm-esco {
        font-size: 1.5rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.03em;
        line-height: 1;
      }
      .esco-wordmark .wm-esco span {
        color: var(--esco-teal);
      }
      /* Teal swoosh underline */
      .esco-swoosh {
        display: block;
        width: 48px;
        height: 6px;
        margin-top: 2px;
        overflow: visible;
      }

      /* Right side of topbar: programme title */
      .topbar-title {
        flex: 1;
        padding-left: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .topbar-title .tt-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--esco-teal);
        line-height: 1;
        margin-bottom: 0.2rem;
      }
      .topbar-title .tt-name {
        font-size: 0.975rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.2;
      }

      /* ═══════════════════════════════════════════
         DRAFT BANNER
      ══════════════════════════════════════════════ */
      .draft-banner {
        position: fixed;
        top: var(--topbar-h);
        left: 0; right: 0;
        height: var(--banner-h);
        background: var(--banner-bg);
        border-bottom: 1px solid var(--banner-border);
        color: var(--banner-text);
        font-size: 0.775rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        z-index: 200;
        letter-spacing: 0.01em;
      }
      .draft-banner strong { font-weight: 700; }

      /* ═══════════════════════════════════════════
         LAYOUT
      ══════════════════════════════════════════════ */
      .site {
        display: flex;
        min-height: 100vh;
        padding-top: var(--header-h);
      }

      /* ═══════════════════════════════════════════
         SIDEBAR
      ══════════════════════════════════════════════ */
      .sidebar {
        width: var(--sidebar-w);
        flex-shrink: 0;
        position: sticky;
        top: var(--header-h);
        height: calc(100vh - var(--header-h));
        overflow-y: auto;
        background: var(--sidebar-bg);
        border-right: 1px solid var(--border);
        padding: 1.25rem 0 2rem;
        display: flex;
        flex-direction: column;
      }

      .nav-group { margin-bottom: 0.25rem; }

      .nav-group-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-faint);
        padding: 0.875rem 1.25rem 0.3rem;
        display: block;
      }

      .nav-list { list-style: none; }

      .nav-list a {
        display: block;
        padding: 0.4rem 1.25rem;
        font-size: 0.875rem;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.1s, background 0.1s;
        border-left: 2px solid transparent;
      }
      .nav-list a:hover {
        color: var(--text);
        background: rgba(0,0,0,0.03);
      }
      .nav-list a.active {
        color: var(--esco-purple);
        font-weight: 600;
        border-left-color: var(--esco-purple);
        background: var(--accent-light);
      }

      .nav-list.sub a {
        padding-left: 1.75rem;
        font-size: 0.8rem;
      }

      /* ═══════════════════════════════════════════
         CONTENT AREA
      ══════════════════════════════════════════════ */
      .content-wrap {
        flex: 1;
        min-width: 0;
      }

      /* Page hero strip — ESco teal-light band at top of each page */
      .page-hero {
        background: var(--esco-purple);
        padding: 2rem 4rem 2rem 2.5rem;
        border-bottom: 3px solid var(--esco-teal);
        position: relative;
        overflow: hidden;
      }
      .page-hero::after {
        content: '';
        position: absolute;
        right: -60px; top: -60px;
        width: 220px; height: 220px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
        pointer-events: none;
      }
      .page-hero .hero-eyebrow {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--esco-teal);
        margin-bottom: 0.35rem;
      }
      .page-hero .hero-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        margin-bottom: 0.4rem;
      }
      .page-hero .hero-sub {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.65);
        line-height: 1.5;
        max-width: 560px;
      }

      .page-body {
        padding: 2.5rem 4rem 6rem 2.5rem;
        max-width: 740px;
      }

      /* ═══════════════════════════════════════════
         TYPOGRAPHY
      ══════════════════════════════════════════════ */
      .page-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        margin-bottom: 0.4rem;
      }
      .page-subtitle {
        font-size: 0.9rem;
        color: rgba(255,255,255,0.65);
        margin-bottom: 0;
        line-height: 1.5;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .section-heading {
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--esco-purple-dark);
        margin-bottom: 0.75rem;
        margin-top: 2.25rem;
        padding-bottom: 0.4rem;
        border-bottom: 2px solid var(--esco-teal-light);
      }
      .section-heading:first-child { margin-top: 0; }

      /* ═══════════════════════════════════════════
         PLACEHOLDER CALLOUT
      ══════════════════════════════════════════════ */
      .placeholder {
        background: var(--ph-bg);
        border: 1px solid var(--ph-border);
        border-radius: 6px;
        padding: 0.875rem 1.1rem;
        font-size: 0.85rem;
        color: var(--ph-text);
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
      }
      .placeholder::before {
        content: '📋';
        flex-shrink: 0;
        font-size: 1rem;
        line-height: 1.4;
      }
      .placeholder strong { color: #78350f; font-weight: 600; }

      /* ═══════════════════════════════════════════
         PROSE
      ══════════════════════════════════════════════ */
      .prose h2, .prose h3, .prose h4 {
        font-weight: 700;
        line-height: 1.3;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        color: var(--esco-purple-dark);
      }
      .prose h2 { font-size: 1.1rem; padding-bottom: 0.3rem; border-bottom: 2px solid var(--esco-teal-light); }
      .prose h3 { font-size: 0.975rem; }
      .prose p { margin-bottom: 0.875rem; font-size: 0.9375rem; }
      .prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 0.875rem; }
      .prose li { margin-bottom: 0.25rem; font-size: 0.9375rem; }
      .prose a { color: var(--esco-purple); text-decoration: underline; }
      .prose strong { font-weight: 600; }
      .prose blockquote {
        background: var(--ph-bg);
        border: 1px solid var(--ph-border);
        border-left: 4px solid var(--ph-border);
        border-radius: 0 6px 6px 0;
        padding: 0.875rem 1.1rem;
        margin: 0.5rem 0;
      }
      .prose blockquote p { color: var(--ph-text); font-size: 0.85rem; margin-bottom: 0; }

      /* ═══════════════════════════════════════════
         VERDICT BADGE
      ══════════════════════════════════════════════ */
      .verdict {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
      }
      .verdict.chosen  { background: var(--chosen-bg);   color: var(--chosen-text); }
      .verdict.rejected { background: rgba(255,255,255,0.18); color: rgba(255,255,255,0.85); }

      /* ═══════════════════════════════════════════
         RESPONSIVE
      ══════════════════════════════════════════════ */
      @media (max-width: 768px) {
        .sidebar { display: none; }
        .page-body { padding: 1.5rem 1.25rem 4rem; }
        .page-hero { padding: 1.5rem 1.25rem; }
        .topbar-title .tt-name { font-size: 0.85rem; }
      }
    </style>
  </head>
  <body>

    <!-- TOP BAR -->
    <header class="topbar">
      <a class="topbar-logo" href="/">
        <div class="esco-wordmark">
          <span class="wm-esco">e<span>S</span>co</span>
          <svg class="esco-swoosh" viewBox="0 0 52 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M2 6 C10 2, 22 1, 32 3 C40 4.5, 46 5, 50 3" stroke="oklch(0.7193 0.123 193.41)" stroke-width="2.5" stroke-linecap="round" fill="none"/>
          </svg>
        </div>
        <div style="width:1px; height:28px; background:rgba(255,255,255,0.15); margin: 0 0.25rem;"></div>
        <div class="topbar-title">
          <span class="tt-label">Internal</span>
          <span class="tt-name">Tech Transformation</span>
        </div>
      </a>

      <!-- Right side spacer / could hold breadcrumb later -->
      <div style="flex:1"></div>
    </header>

    <!-- DRAFT BANNER -->
    {isDraft && (
      <div class="draft-banner">
        <strong>Draft in progress</strong> -- this site is being built out. Content will continue to be added.
      </div>
    )}

    <!-- BODY -->
    <div class="site">
      <aside class="sidebar">
        {nav.map(group => (
          <div class="nav-group">
            {group.label && <span class="nav-group-label">{group.label}</span>}
            <ul class={`nav-list${group.label ? ' sub' : ''}`}>
              {group.items.map(item => {
                const isActive = item.href === '/'
                  ? currentPath === '/'
                  : currentPath.startsWith(item.href);
                return (
                  <li>
                    <a href={item.href} class={isActive ? 'active' : ''}>
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </aside>

      <div class="content-wrap">
        <slot />
      </div>
    </div>

  </body>
</html>
