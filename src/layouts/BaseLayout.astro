---
// Set to false when the site is ready to publish
const isDraft = false;

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'ESco technology transformation programme handover.' } = Astro.props;

const nav = [
  {
    items: [
      { href: '/', label: 'Summary' },
    ],
  },
  {
    label: 'Technology',
    items: [
      { href: '/phases/phase-1', label: 'Phase 1: Azure / Microsoft' },
      { href: '/phases/phase-2', label: 'Phase 2: Off the shelf' },
      { href: '/phases/phase-3', label: 'Phase 3: Hybrid build and buy' },
      { href: '/phases/phase-4', label: 'Phase 4: CRM agnostic core' },
    ],
  },
  {
    items: [
      { href: '/people-context', label: 'People' },
      { href: '/process-changes', label: 'Process' },
    ],
  },
  {
    items: [
      { href: '/architecture',  label: 'Target Architecture' },
      { href: '/current-state', label: 'Current State' },
      { href: '/reference',     label: 'Reference' },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} | ESco Tech Transformation</title>

    <!-- Password gate (client-side, casual protection only) -->
    <script is:inline>
      (function () {
        var EXPECTED = '71fb4daceabfa1591d91fe464f68abae9e937088c1de9baf4022959c5f87c617';
        var KEY = 'esco_tt_auth_v2';
        try { if (sessionStorage.getItem(KEY) === EXPECTED) return; } catch (e) {}

        // Hide page contents until authed
        document.documentElement.style.visibility = 'hidden';

        async function sha256(s) {
          var buf = new TextEncoder().encode(s);
          var hash = await crypto.subtle.digest('SHA-256', buf);
          return Array.from(new Uint8Array(hash))
            .map(function (b) { return b.toString(16).padStart(2, '0'); }).join('');
        }

        function gate() {
          document.documentElement.style.visibility = 'visible';
          document.body.innerHTML =
            '<div id="gate" style="position:fixed;inset:0;background:#fff;display:flex;align-items:center;justify-content:center;z-index:99999;font-family:Inter,system-ui,sans-serif;">' +
            '  <form id="gate-form" style="max-width:340px;width:100%;padding:2rem;text-align:left;">' +
            '    <div style="font-size:1.75rem;font-weight:800;color:oklch(0.3529 0.131 313.78);letter-spacing:-0.01em;line-height:1;">ESco</div>' +
            '    <div style="font-size:0.7rem;font-weight:700;color:oklch(0.7193 0.123 193.41);letter-spacing:0.18em;text-transform:uppercase;margin-top:0.5rem;">Tech Transformation</div>' +
            '    <div style="height:3px;background:#f08a6e;margin:1.25rem 0 1.5rem;width:60px;"></div>' +
            '    <label for="gate-pw" style="display:block;font-size:0.8rem;color:#374151;font-weight:600;margin-bottom:0.5rem;">Password</label>' +
            '    <input id="gate-pw" type="password" autocomplete="off" autofocus style="width:100%;padding:0.6rem 0.75rem;font-size:0.95rem;border:1px solid #d1d5db;border-radius:6px;outline:none;font-family:inherit;" />' +
            '    <div id="gate-err" style="color:#b91c1c;font-size:0.8rem;margin-top:0.5rem;min-height:1.1rem;"></div>' +
            '    <button type="submit" style="margin-top:0.5rem;width:100%;padding:0.65rem;background:oklch(0.408 0.157 313.5);color:#fff;border:none;border-radius:6px;font-weight:600;font-size:0.9rem;cursor:pointer;font-family:inherit;">Continue</button>' +
            '    <div style="font-size:0.7rem;color:#9ca3af;margin-top:1rem;line-height:1.5;">This site documents an internal technology programme. Access is restricted.</div>' +
            '  </form>' +
            '</div>';

          document.getElementById('gate-form').addEventListener('submit', async function (e) {
            e.preventDefault();
            var pw = document.getElementById('gate-pw').value;
            var hex = await sha256(pw);
            if (hex === EXPECTED) {
              try { sessionStorage.setItem(KEY, EXPECTED); } catch (e) {}
              location.reload();
            } else {
              document.getElementById('gate-err').textContent = 'Incorrect password.';
              document.getElementById('gate-pw').select();
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', gate);
        } else {
          gate();
        }
      })();
    </script>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --font:            'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

        /* ESco brand colours (exact from esco.co.uk) */
        --esco-purple:       oklch(0.408 0.157 313.5);
        --esco-purple-dark:  oklch(0.3529 0.131 313.78);
        --esco-teal:         oklch(0.7193 0.123 193.41);
        --esco-teal-light:   oklch(0.8698 0.074 194.81);

        /* Layout */
        --bg:              #ffffff;
        --sidebar-bg:      #f8f9fa;
        --text:            #1c1917;
        --text-muted:      #6b7280;
        --text-faint:      #9ca3af;
        --border:          #e5e7eb;
        --accent:          var(--esco-purple);
        --accent-light:    oklch(0.96 0.02 313.5);

        /* Status colours */
        --banner-bg:       #fef9c3;
        --banner-border:   #fde047;
        --banner-text:     #713f12;
        --ph-bg:           #fefce8;
        --ph-border:       #fde047;
        --ph-text:         #854d0e;
        --chosen-bg:       #dcfce7;
        --chosen-text:     #14532d;
        --rejected-bg:     #f1f5f9;
        --rejected-text:   #475569;

        /* Dimensions */
        --topbar-h:        88px;
        --coral:           #f08a6e;
        --banner-h:        0px;
        --sidebar-w:       248px;
        --header-h:        var(--topbar-h);
      }

      html { font-size: 16px; }

      body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      /* ═══════════════════════════════════════════
         TOP BAR  —  white, brand wordmark, coral line
      ══════════════════════════════════════════════ */
      .topbar {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: var(--topbar-h);
        background: #ffffff;
        border-bottom: 3px solid var(--coral);
        display: flex;
        align-items: center;
        padding: 0 2.5rem;
        z-index: 300;
      }

      .topbar-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        gap: 1rem;
      }
      .topbar-logo .tl-img {
        height: 56px;
        width: auto;
        display: block;
      }
      .topbar-logo .tl-divider {
        width: 1px;
        height: 36px;
        background: var(--border);
      }
      .topbar-logo .tl-sub {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--esco-teal);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        line-height: 1;
      }

      /* ═══════════════════════════════════════════
         DRAFT BANNER
      ══════════════════════════════════════════════ */
      .draft-banner {
        position: fixed;
        top: var(--topbar-h);
        left: 0; right: 0;
        height: var(--banner-h);
        background: var(--banner-bg);
        border-bottom: 1px solid var(--banner-border);
        color: var(--banner-text);
        font-size: 0.775rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        z-index: 200;
        letter-spacing: 0.01em;
      }
      .draft-banner strong { font-weight: 700; }

      /* ═══════════════════════════════════════════
         LAYOUT
      ══════════════════════════════════════════════ */
      .site {
        display: flex;
        min-height: 100vh;
        padding-top: var(--header-h);
      }

      /* ═══════════════════════════════════════════
         SIDEBAR
      ══════════════════════════════════════════════ */
      .sidebar {
        width: var(--sidebar-w);
        flex-shrink: 0;
        position: sticky;
        top: var(--header-h);
        height: calc(100vh - var(--header-h));
        overflow-y: auto;
        background: var(--sidebar-bg);
        border-right: 1px solid var(--border);
        padding: 1.25rem 0 2rem;
        display: flex;
        flex-direction: column;
      }

      .nav-group { margin-bottom: 0.25rem; }

      .nav-group-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-faint);
        padding: 0.875rem 1.25rem 0.3rem;
        display: block;
      }

      .nav-list { list-style: none; }

      .nav-list a {
        display: block;
        padding: 0.4rem 1.25rem;
        font-size: 0.875rem;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.1s, background 0.1s;
        border-left: 2px solid transparent;
      }
      .nav-list a:hover {
        color: var(--text);
        background: rgba(0,0,0,0.03);
      }
      .nav-list a.active {
        color: var(--esco-purple);
        font-weight: 600;
        border-left-color: var(--esco-purple);
        background: var(--accent-light);
      }

      .nav-list.sub a {
        padding-left: 1.75rem;
        font-size: 0.8rem;
      }

      /* ═══════════════════════════════════════════
         CONTENT AREA
      ══════════════════════════════════════════════ */
      .content-wrap {
        flex: 1;
        min-width: 0;
      }

      /* Page hero strip — white with teal accent line */
      .page-hero {
        background: #ffffff;
        padding: 2.25rem 4rem 1.75rem 2.5rem;
        border-bottom: 3px solid var(--esco-teal);
        position: relative;
      }
      .page-hero .hero-eyebrow {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--esco-purple);
        margin-bottom: 0.35rem;
      }

      .page-body {
        padding: 2.5rem 4rem 6rem 2.5rem;
        max-width: 740px;
      }

      /* ═══════════════════════════════════════════
         TYPOGRAPHY
      ══════════════════════════════════════════════ */
      .page-title {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--esco-purple-dark);
        line-height: 1.2;
        margin-bottom: 0.5rem;
      }
      .page-subtitle {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0;
        line-height: 1.5;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .section-heading {
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--esco-purple-dark);
        margin-bottom: 0.75rem;
        margin-top: 2.25rem;
        padding-bottom: 0.4rem;
        border-bottom: 2px solid var(--esco-teal-light);
      }
      .section-heading:first-child { margin-top: 0; }

      /* ═══════════════════════════════════════════
         PLACEHOLDER CALLOUT
      ══════════════════════════════════════════════ */
      .placeholder {
        background: var(--ph-bg);
        border: 1px solid var(--ph-border);
        border-radius: 6px;
        padding: 0.875rem 1.1rem;
        font-size: 0.85rem;
        color: var(--ph-text);
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
      }
      .placeholder::before {
        content: '📋';
        flex-shrink: 0;
        font-size: 1rem;
        line-height: 1.4;
      }
      .placeholder strong { color: #78350f; font-weight: 600; }

      /* ═══════════════════════════════════════════
         PROSE
      ══════════════════════════════════════════════ */
      .prose h2, .prose h3, .prose h4 {
        font-weight: 700;
        line-height: 1.3;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        color: var(--esco-purple-dark);
      }
      .prose h2 { font-size: 1.1rem; padding-bottom: 0.3rem; border-bottom: 2px solid var(--esco-teal-light); }
      .prose h3 { font-size: 0.975rem; }
      .prose p { margin-bottom: 0.875rem; font-size: 0.9375rem; }
      .prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 0.875rem; }
      .prose li { margin-bottom: 0.25rem; font-size: 0.9375rem; }
      .prose a { color: var(--esco-purple); text-decoration: underline; }
      .prose strong { font-weight: 600; }
      .prose blockquote {
        background: var(--ph-bg);
        border: 1px solid var(--ph-border);
        border-left: 4px solid var(--ph-border);
        border-radius: 0 6px 6px 0;
        padding: 0.875rem 1.1rem;
        margin: 0.5rem 0;
      }
      .prose blockquote p { color: var(--ph-text); font-size: 0.85rem; margin-bottom: 0; }

      /* ═══════════════════════════════════════════
         VERDICT BADGE
      ══════════════════════════════════════════════ */
      .verdict {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
      }
      .verdict.chosen   { background: var(--chosen-bg);   color: var(--chosen-text); }
      .verdict.rejected { background: var(--rejected-bg); color: var(--rejected-text); }
      .verdict.underway { background: #dbeafe;            color: #1e3a8a; }

      /* ═══════════════════════════════════════════
         RESPONSIVE
      ══════════════════════════════════════════════ */
      @media (max-width: 768px) {
        .sidebar { display: none; }
        .page-body { padding: 1.5rem 1.25rem 4rem; }
        .page-hero { padding: 1.5rem 1.25rem; }
        .topbar-title .tt-name { font-size: 0.85rem; }
      }
    </style>
  </head>
  <body>

    <!-- TOP BAR -->
    <header class="topbar">
      <a class="topbar-logo" href="/">
        <img class="tl-img" src="/esco-logo.svg" alt="ESco" />
        <span class="tl-divider" aria-hidden="true"></span>
        <span class="tl-sub">Tech Transformation</span>
      </a>
    </header>

    <!-- DRAFT BANNER -->
    {isDraft && (
      <div class="draft-banner">
        <strong>Draft in progress</strong>, this site is being built out. Content will continue to be added.
      </div>
    )}

    <!-- BODY -->
    <div class="site">
      <aside class="sidebar">
        {nav.map(group => (
          <div class="nav-group">
            {group.label && <span class="nav-group-label">{group.label}</span>}
            <ul class={`nav-list${group.label ? ' sub' : ''}`}>
              {group.items.map(item => {
                const isActive = item.href === '/'
                  ? currentPath === '/'
                  : currentPath.startsWith(item.href);
                return (
                  <li>
                    <a href={item.href} class={isActive ? 'active' : ''}>
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </aside>

      <div class="content-wrap">
        <slot />
      </div>
    </div>

  </body>
</html>
